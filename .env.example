# Copy to .env.local and fill in. Never commit real values.

# Cloudflare Turnstile (contact and support forms). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# For local testing Cloudflare publishes dummy keys:
#   site key   1x00000000000000000000AA  (always passes)
#   secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where enquiries are delivered (required in production).
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
