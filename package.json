{
  "name": "etriplesoft-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "check": "tsc --noEmit",
    "test:seo": "node --no-warnings scripts/seo-audit.mjs",
    "check-links": "node --no-warnings scripts/check-links.mjs",
    "check-redirects": "node --no-warnings scripts/check-redirects.mjs",
    "check-site": "npm run check && npm run check-links && npm run check-redirects && npm run test:seo && npm run check-content",
    "test:qa": "node --no-warnings scripts/test-qa.mjs",
    "check-responsive": "node --no-warnings scripts/check-responsive.mjs",
    "check-content": "node --no-warnings scripts/check-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.0.0"
  }
}
